{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "URPv3EvidenceRecord",
  "description": "Validates YAML frontmatter for URP v3.0 standalone evidence records (E-NNN)",
  "type": "object",
  "required": ["id", "title", "grade", "modifiers", "verification", "source"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-\\d{3}$",
      "description": "Evidence identifier (e.g., E-001, E-047)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Descriptive title of the evidence"
    },
    "grade": {
      "enum": ["A", "B", "C", "D", "E"],
      "description": "Base evidentiary tier"
    },
    "modifiers": {
      "type": "object",
      "required": ["corroboration", "recency", "directness"],
      "properties": {
        "corroboration": {
          "enum": ["single", "corroborated", "contested"]
        },
        "recency": {
          "enum": ["fresh", "aging", "stale"]
        },
        "directness": {
          "enum": ["direct", "indirect"]
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["fetched", "cached", "recalled", "secondhand", "human-provided"]
        },
        "fetched_date": {
          "type": "string",
          "format": "date"
        },
        "fetched_by": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "url": { "type": "string" },
        "type": {
          "type": "string",
          "description": "Source category (e.g., official-docs, engineering-postmortem, peer-reviewed, vendor-whitepaper)"
        },
        "author": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "used_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "D-NNN decision IDs that depend on this evidence (blast-radius tracking)"
    }
  },
  "additionalProperties": true
}

references/
brain-archive/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment and Credentials
.env
.env.*
!.env.example

# Logs and Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Dependencies
node_modules/
dist/
build/
.cache/

# IDE / Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# temp
temp/
tmp/

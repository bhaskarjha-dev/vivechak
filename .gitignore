# Vivechak (विवेचक) .gitignore

# Archived development materials
references/
brain-archive/

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# Environment and Credentials
.env
.env.*
!.env.example

# Logs
*.log

# IDE / Editor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sw?

# Go build artifacts
bin/
dist/
*.exe
*.exe~

# Go test/coverage
coverage*
*.out

# Temporary working directories
temp/
tmp/
scratch/

# Lock files left by advisory locking
*.lock
